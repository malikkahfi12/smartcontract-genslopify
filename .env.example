# Copy to .env and fill in.
#
# This file holds deployment PARAMETERS and the NAME of a wallet — never key
# material. NEVER put a private key or mnemonic here. The signer is supplied at
# broadcast time from an encrypted keystore (`cast wallet import`), not from
# this file. See docs/DEPLOYMENT.md for the full walkthrough.

ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# OPTIONAL — leave empty. Arc's explorer is Blockscout, which needs no API key.
# Verification requires `--verifier blockscout`, not a key. See docs/DEPLOYMENT.md.
ARC_EXPLORER_KEY=

# ---------------------------------------------------------------------------
# Deployment parameters (constructor args — see script/Deploy.s.sol)
# All four are permanent-ish: MIN_TOPUP can NEVER change, and the three
# addresses can only change through a 2-day timelocked proposal.
# ---------------------------------------------------------------------------

# Receives every top-up, immediately, in the same transaction as the payment.
# Testnet: a plain wallet you control (spec 002 Q5 -> B).
# Changing it later takes 2 days and needs admin approval.
TREASURY_ADDRESS=

# Governing authority. Can propose treasury changes, transfer its own authority,
# and change the pauser — but every one of those waits the full 2 days, and none
# of them can move funds. On testnet this stays a single primary key permanently
# (spec 002 Q2 -> B).
ADMIN_ADDRESS=

# Emergency stop. Can ONLY pause and unpause top-ups — immediately, with no
# waiting period. Cannot touch the treasury, cannot transfer authority, cannot
# move funds. This is the only fast incident response that exists, because the
# contract is immutable and top-ups are irreversible.
#
# MUST be a different key from ADMIN_ADDRESS for this deployment. The deploy
# script refuses to broadcast if they match.
PAUSER_ADDRESS=

# Smallest accepted top-up, in wei (native USDC on Arc has 18 decimals, so
# 1 USDC = 1000000000000000000). Fixed forever at deployment — choose carefully,
# because changing it requires deploying a new contract.
MIN_TOPUP_WEI=

# ---------------------------------------------------------------------------
# Signer (NOT secret — see docs/DEPLOYMENT.md)
#
# script/Deploy.s.sol calls vm.startBroadcast() with no argument, meaning "sign
# with whatever signer the CLI provides". These two values just name that
# signer; the key itself lives password-encrypted in ~/.foundry/keystores and
# is never read from this file.
#
#   cast wallet import arc-deployer --interactive
#   cast wallet address --account arc-deployer
# ---------------------------------------------------------------------------

# Keystore account names, as passed to `--account`. Each role signs its own
# calls — they are NOT interchangeable. An admin-only call sent from the
# deployer key reverts NotAdmin. See docs/OPERATIONS.md.
DEPLOYER_ACCOUNT=arc-deployer
ADMIN_ACCOUNT=arc-admin
PAUSER_ACCOUNT=arc-pauser

# Any funded keystore account. Used only for apply*() calls, which are
# permissionless once a proposal's 2-day delay has elapsed.
ANY_FUNDED_ACCOUNT=arc-deployer

# The address that account controls, as passed to `forge script --sender`.
# Usually the same as ADMIN_ADDRESS above.
DEPLOYER_ADDRESS=

# Optional: --account reads this env var, so setting it lets you drop that flag.
# --sender has no env equivalent in this Foundry version, so keep passing it.
# ETH_KEYSTORE_ACCOUNT=arc-deployer
