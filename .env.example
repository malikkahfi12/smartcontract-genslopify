# Copy to .env and fill in.
#
# This file holds deployment PARAMETERS and the NAME of a wallet — never key
# material. NEVER put a private key or mnemonic here. The signer is supplied at
# broadcast time from an encrypted keystore (`cast wallet import`), not from
# this file. See docs/DEPLOYMENT.md for the full walkthrough.

# ---------------------------------------------------------------------------
# Network switch
#
# DEPLOY_NETWORK is "testnet" or "mainnet" (lowercase, exactly). script/Deploy.s.sol
# refuses to broadcast unless the --rpc-url chain matches it:
#   testnet -> chain 5042002    mainnet -> chain 5042
# So pass the matching RPC:  --rpc-url arc_testnet   or   --rpc-url arc_mainnet
# (aliases defined in foundry.toml, reading the two URLs below).
# Network details: https://docs.arc.io/integrate/connect-to-arc
# ---------------------------------------------------------------------------
DEPLOY_NETWORK=testnet

ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io

# OPTIONAL — leave empty. Arc's explorers are Blockscout, which needs no API key:
#   testnet: https://explorer.testnet.arc.io    mainnet: https://explorer.arc.io
# Verification requires `--verifier blockscout`, not a key. See docs/DEPLOYMENT.md.
ARC_EXPLORER_KEY=

# ---------------------------------------------------------------------------
# Deployment parameter (constructor arg — see script/Deploy.s.sol)
#
# There is exactly one, and it is PERMANENT.
# ---------------------------------------------------------------------------

# Receives every top-up, immediately, in the same transaction as the payment.
#
# THIS CAN NEVER BE CHANGED. Not by an admin, not after a delay, not by anyone —
# the deployed contract has no function that changes it. Two consequences, both
# without remedy:
#
#   1. A wrong address routes every future top-up to it, irreversibly.
#   2. A CONTRACT treasury that reverts on receipt makes every top-up fail
#      forever, bricking the deployment from block one.
#
# Verify this address against an independent source, and send one real top-up
# to confirm it accepts funds, before announcing the router.
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# NOT parameters any more (spec 003). If these are still in your local .env from
# a previous deployment, they are ignored entirely and reach nothing:
#
#   ADMIN_ADDRESS    — no administrator exists
#   PAUSER_ADDRESS   — no pauser exists; top-ups cannot be halted
#   MIN_TOPUP_WEI    — the minimum is a compile-time constant (1e18 = 1 USDC)
#
# Note on denomination: native USDC on Arc (testnet AND mainnet) has 18
# DECIMALS. One whole USDC is 1000000000000000000 base units. (The 6-decimal
# ERC-20 interface does not apply to native value transfers.)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Signer (NOT secret — see docs/DEPLOYMENT.md)
#
# script/Deploy.s.sol calls vm.startBroadcast() with no argument, meaning "sign
# with whatever signer the CLI provides". These values just name that signer;
# the key itself lives password-encrypted in ~/.foundry/keystores and is never
# read from this file.
#
#   cast wallet import arc-deployer --interactive
#   cast wallet address --account arc-deployer
# ---------------------------------------------------------------------------

# Keystore account name, as passed to `--account`. Only one is needed now: there
# are no role-specific calls to sign, because there are no roles. Consider a
# separate keystore (e.g. arc-deployer-mainnet) funded only on mainnet.
DEPLOYER_ACCOUNT=arc-deployer

# The address that account controls, as passed to `forge script --sender`.
DEPLOYER_ADDRESS=

# Optional: --account reads this env var, so setting it lets you drop that flag.
# --sender has no env equivalent in this Foundry version, so keep passing it.
# ETH_KEYSTORE_ACCOUNT=arc-deployer

# OPTIONAL, for the fork test's strict denomination check. A faucet-funded
# address (https://faucet.circle.com). When set, test/fork/ArcTestnet.t.sol
# asserts its balance is consistent with 18 decimals rather than 6.
ARC_FUNDED_ACCOUNT=
